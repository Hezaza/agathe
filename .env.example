# À renseigner dans Vercel : Settings > Environment Variables (jamais dans GitHub)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # clé « anon / public » (peut être publique)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # clé « service_role » : SECRÈTE, serveur uniquement
ANTHROPIC_API_KEY=sk-ant-...      # assistant AGATHE : SECRÈTE, serveur uniquement (facultatif, prioritaire)
GROQ_API_KEY=gsk_...              # alternative gratuite (Groq) : SECRÈTE, utilisée si ANTHROPIC_API_KEY est absente
# GROQ_MODEL=openai/gpt-oss-120b   GROQ_VISION_MODEL=qwen/qwen3.8-27b   AI_PROVIDER=groq|anthropic (forcer)
